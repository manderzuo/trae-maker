# Nginx 与 frps 在同一台中转机时使用。
# frps 的 remotePort 只作为 Nginx 上游，不应直接对不可信网段开放。

server {
    listen 80;
    server_name __AIWORK_LAN_OR_PUBLIC_HOST__;

    client_max_body_size 46m;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    location = /healthz {
        proxy_pass http://127.0.0.1:17864/healthz;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:17864;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 公网正式环境应改为 listen 443 ssl，并配置证书；不要把 AI Work 的 7864 直接暴露到公网。
